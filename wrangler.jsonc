{
  "name": "phut1",
  "compatibility_date": "2025-02-14",
  "pages_build_output_dir": "./dist",
  // Tích hợp trực tiếp Cloudflare Workers AI (https://dash.cloudflare.com/.../ai/models)
  "ai": {
    "binding": "AI",
  },
  // Vector Database chuyên dụng Cloudflare Vectorize (RAG AI Barista Chatbot)
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "moc-coffee-vector-index",
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "DEFAULT_SHIPPING_FEE": "30000",
    "FREE_SHIPPING_THRESHOLD": "500000",
    "CF_EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "CF_LLM_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moc-coffee-db",
      "database_id": "12f6ab15-7168-4645-a100-82e644278767",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "1cfd1e06a8d34d06bece1862dcf86e1d",
    },
  ],
}
